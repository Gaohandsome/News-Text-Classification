# 复制为 .env 后填写，切勿把真实 Key 提交到 Git

# ---------- LLM 供应商 ----------
# 可选：deepseek | zhipu | dashscope
NEWSCLF_LLM_PROVIDER=deepseek

# 只需填写当前使用的那一个
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=

# 可选：覆盖默认模型名
# NEWSCLF_LLM_MODEL=deepseek-chat

# ---------- 可选运行参数（不填则使用默认值） ----------
# NEWSCLF_DEVICE=cuda
# NEWSCLF_SEED=42
# NEWSCLF_BATCH_SIZE=64
# NEWSCLF_MAX_LEN=32

# 预训练权重目录，默认 ./pretrained
# NEWSCLF_PRETRAINED_DIR=./pretrained
# BERT 子目录名，默认 bert-base-chinese
# NEWSCLF_BERT_MODEL=bert-base-chinese

# FastText 切分粒度：word | char
# NEWSCLF_FASTTEXT_GRANULARITY=word
# NEWSCLF_FASTTEXT_AUTOTUNE=true
# NEWSCLF_FASTTEXT_AUTOTUNE_SECONDS=300

# ---------- 训练超参 ----------
# NEWSCLF_RF_TREES=100
# NEWSCLF_BERT_EPOCHS=3
# NEWSCLF_BERT_LR=5e-5
# NEWSCLF_LSTM_LR=1e-3
# NEWSCLF_DISTILL_ALPHA=0.7
# NEWSCLF_DISTILL_TEMPERATURE=2.0
# NEWSCLF_PRUNE_AMOUNT=0.3
